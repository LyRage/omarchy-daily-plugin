#!/usr/bin/env node
// Puts the newest edition on claude.ai, at the same private link every day.
// Writes the web copy, hands it to a locked-down background Claude Code
// session to publish, waits for the link, and prints a line of JSON.
//
//   quattro-daily-publish [--date YYYY-MM-DD] [--dry-run]
//
// --dry-run writes the web copy and prints the command, without publishing.

"use strict"

const fs = require("node:fs")
const path = require("node:path")
const { execFileSync } = require("node:child_process")

const ROOT = path.join(__dirname, "..")
const Model = require(path.join(ROOT, "Model.js"))
const { webCopy, fileChanges } = require(path.join(ROOT, "lib/web.js"))

function args(argv) {
  const out = { date: "", dryRun: false }
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === "--date") out.date = argv[++i] || ""
    else if (argv[i] === "--dry-run") out.dryRun = true
    else if (argv[i] === "-h" || argv[i] === "--help") { process.stdout.write(fs.readFileSync(__filename, "utf8").split("\n").slice(1, 8).join("\n").replace(/^\/\/ ?/gm, "") + "\n"); process.exit(0) }
  }
  return out
}

function readJson(file) {
  try { return JSON.parse(fs.readFileSync(file, "utf8")) } catch (e) { return null }
}

function sleep(ms) { Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms) }

function run(argv, cwd) {
  try {
    return { ok: true, out: execFileSync(argv[0], argv.slice(1), { cwd: cwd, encoding: "utf8", timeout: 60000, stdio: ["ignore", "pipe", "pipe"] }) }
  } catch (e) {
    return { ok: false, out: String(e.stdout || "") + String(e.stderr || "") }
  }
}

function fail(message) {
  process.stdout.write(JSON.stringify({ ok: false, error: message }) + "\n")
  process.exit(1)
}

function main() {
  const opt = args(process.argv.slice(2))
  const dataDir = Model.dataPath(process.env.HOME)
  const webDir = path.join(dataDir, "web")
  const stateFile = path.join(webDir, "state.json")
  const linkFile = path.join(webDir, "link.txt")

  const indexFile = path.join(dataDir, "editions.json")
  const index = Model.parseIndex(fs.existsSync(indexFile) ? fs.readFileSync(indexFile, "utf8") : "")
  const entry = opt.date ? index.find(e => e.date === opt.date) : index[0]
  if (!entry) fail("No edition to publish yet.")

  // The web copy, with last time's photos cleared away.
  const copy = webCopy(fs.readFileSync(Model.editionPath(process.env.HOME, entry.date), "utf8"))
  const state = readJson(stateFile) || {}
  fs.rmSync(path.join(webDir, "img"), { recursive: true, force: true })
  fs.mkdirSync(path.join(webDir, "img"), { recursive: true })
  for (const im of copy.images) fs.writeFileSync(path.join(webDir, im.path), im.data)
  fs.writeFileSync(path.join(webDir, "index.html"), copy.html)
  fs.rmSync(linkFile, { force: true })

  const files = copy.images.map(im => im.path)
  const changes = fileChanges(state.files, files)
  const cmd = Model.publishCommand(webDir, Model.publishPrompt({ url: Model.artifactUrl(state.url), files: changes.keep, remove: changes.remove }))
  if (opt.dryRun) { process.stdout.write(JSON.stringify({ ok: true, dryRun: true, date: entry.date, command: cmd }, null, 2) + "\n"); return }

  // From the paper's own folder, which Claude Code must trust; the agent
  // desk leaves sessions there out of the paper.
  const started = run(cmd, dataDir)
  if (/not trusted/i.test(started.out)) fail("Claude Code doesn't trust " + dataDir + " yet. Run claude there once and accept.")
  const id = (started.out.match(/claude stop ([0-9a-f]{6,})/) || [])[1]
  if (!id) fail("Claude Code didn't start: " + started.out.trim().split("\n").pop())

  let answer = ""
  const deadline = Date.now() + Model.PUBLISH_TIMEOUT_MS
  while (Date.now() < deadline) {
    try { answer = fs.readFileSync(linkFile, "utf8").trim() } catch (e) {}
    if (answer) break
    sleep(3000)
  }
  run(["claude", "stop", id], dataDir)
  run(["claude", "rm", id], dataDir)

  const link = Model.artifactUrl(answer)
  if (!link) fail(answer ? answer.slice(0, 200) : "Claude didn't hand back a link in time.")
  fs.writeFileSync(stateFile, JSON.stringify({ url: link, date: entry.date, files: files, publishedAt: Date.now() }, null, 2) + "\n")
  process.stdout.write(JSON.stringify({ ok: true, date: entry.date, url: link }) + "\n")
}

main()
